# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# VS Code specific (allow settings.json for team uniformity)
.vscode/*
!.vscode/settings.json

# Dataset media (allow sample benchmark data for immediate out-of-the-box testing)
!dataset/train/real/*.jpg
!dataset/train/fake/*.jpg
!dataset/validation/real/*.jpg
!dataset/validation/fake/*.jpg
!dataset/test/real/*.jpg
!dataset/test/fake/*.jpg
!dataset/**/.gitkeep

# Temporary analysis files
temp_uploads/
temp_frames/
*.log

# Generated PDF reports (preserve directory structure via .gitkeep)
reports/*.pdf
!reports/.gitkeep

# Heavy ML checkpoints (keep production models and JSONs)
*.h5
*.pb
!saved_models/xception_deepfake.keras
!saved_models/temporal_video_model.json
!saved_models/.gitkeep

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
